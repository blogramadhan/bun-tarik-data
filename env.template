# ===========================================
# TEMPLATE FILE ENVIRONMENT (.env)
# ===========================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai

# Konfigurasi WhatsApp
# Nomor penerima WhatsApp (format: 628123456789)
# Untuk multiple nomor, pisahkan dengan koma: 628123456789,628987654321
WHATSAPP_RECIPIENT_NUMBERS=628123456789

# Konfigurasi Puppeteer (sudah di-set di Docker)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Environment
NODE_ENV=production

# ===========================================
# CARA PENGGUNAAN:
# 1. Copy file ini: cp env.template .env
# 2. Edit file .env: nano .env
# 3. Isi WHATSAPP_RECIPIENT_NUMBERS dengan nomor yang benar
# =========================================== 